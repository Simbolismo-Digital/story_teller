<div class="flex h-screen w-screen overflow-hidden">
  <!-- Main Content -->
  <div class="flex flex-col flex-1 bg-gray-900 text-white">
    
<!-- Scene (AI Output) -->
    <.live_component module={StoryTellerWeb.Campaign.SceneComponent} id="scene" scene={@scene} />

    <div class="grid grid-cols-2 gap-4 p-4 h-[35vh]">
      <!-- Current Actions -->
      <.live_component
        module={StoryTellerWeb.Campaign.CurrentActionsComponent}
        id="actions"
        characters={@characters}
      />
      
<!-- Action Input -->
      <%= if @current_actor do %>
        <.live_component
          module={StoryTellerWeb.Campaign.ActionInputComponent}
          id="action-input"
          current_actor={@current_actor}
        />
      <% else %>
        <div class="flex items-center justify-center text-gray-400">
          Select a character to act.
        </div>
      <% end %>
    </div>
  </div>
  
<!-- Sidebar -->
  <.live_component
    module={StoryTellerWeb.Campaign.SidebarComponent}
    id="sidebar"
    characters={@characters}
    current_actor={@current_actor}
  />
</div>
