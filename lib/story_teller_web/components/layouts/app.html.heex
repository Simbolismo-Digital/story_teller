<div class="flex flex-col h-screen">
  <!-- Header -->
  <header class="bg-gray-900 text-white flex-shrink-0">
    <div class="flex items-center justify-between border-b border-gray-700 py-3 text-sm w-full">
      <div class="flex items-center gap-4">
        <a href="/">
          <img src={~p"/images/logo.png"} width="36" />
        </a>
        <p class="bg-gray-800 text-white rounded-full px-2 font-medium leading-6">
          v{Application.spec(:phoenix, :vsn)}
        </p>
      </div>
      <div class="flex items-center gap-4 font-semibold leading-6 text-white">
        <!-- additional header content -->
      </div>
    </div>
  </header>
  
<!-- Main content fills remaining space -->
  <main class="flex-1 w-full m-0 p-0 flex flex-col overflow-hidden">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
